# Copy to .env and fill in. docker-compose reads this file automatically.
#
# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fieldwork
DB_USER=fieldwork
DB_PASSWORD=changeme

# JWT access-token signing secret (HMAC-SHA-256). REQUIRED in every real
# environment: minimum 32 bytes / 256 bits. Leaving it unset falls back
# to a dev-only default that logs a warning at startup — never deploy
# with the default. Generate a strong value with:
#   openssl rand -base64 48
JWT_SECRET=

# Comma-separated list of SPA origins allowed to call the API
# (CORS). Defaults to the local Vite dev server.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
