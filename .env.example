# Copy this file to `.env` and adjust. Never commit `.env` — it holds secrets.
# docker compose reads `.env` automatically from the project root.

# --- Application ---
# Host port the API is published on.
APP_PORT=8080

# --- PostgreSQL ---
# DB_HOST is only used when running the app outside docker compose
# (e.g. from an IDE). Inside compose the app always talks to the `db` service.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fieldwork
DB_USER=fieldwork
# Pick a real password for any shared/dev environment. This default is for
# local development only.
DB_PASSWORD=changeme

# --- AWS S3 attachments (Phase 7) ---
# Bound into the app via application.yml `app.s3.*`. Inside docker
# compose the app talks to the `localstack` service; when running the
# app outside compose (e.g. from an IDE) point S3_ENDPOINT at
# http://localhost:4566. Leave S3_ENDPOINT empty to use real AWS S3 —
# then you MUST set real S3_ACCESS_KEY / S3_SECRET_KEY.
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=fieldwork-attachments
# Dev-only credentials: "test"/"test" is what LocalStack expects.
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
# Optional: S3_MAX_FILE_SIZE (bytes, default 10485760 = 10 MiB),
# S3_ALLOWED_CONTENT_TYPES (comma-separated).

# --- Phase 6: async/event processing (all optional; defaults live in application.yml) ---
# SLA_SCAN_CRON=0 */5 * * * *
# NOTIFICATION_RETRY_FIXED_DELAY=60000
# NOTIFICATION_RETRY_MAX_ATTEMPTS=5
# NOTIFICATION_RETRY_BATCH_SIZE=100
